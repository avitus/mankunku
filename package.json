{
	"name": "mankunku",
	"private": true,
	"version": "0.0.1",
	"engines": {
		"node": ">=22.17.0"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"pdf:eval": "node scripts/evaluate-pdf-import.mjs",
		"pdf:eval:corpus": "node scripts/evaluate-pdf-corpus.mjs",
		"backing:report": "UPDATE_BACKING_REPORT=1 vitest run tests/unit/audio/backing-report.test.ts",
		"backing:golden": "UPDATE_BACKING_GOLDEN=1 vitest run tests/unit/audio/backing-golden.test.ts",
		"test:deploy": "bash deploy/app/release.test.sh",
		"test:watch": "vitest",
		"test:sandbox": "node scripts/test-sandbox.mjs",
		"test:e2e": "node scripts/test-sandbox.mjs e2e",
		"test:e2e:ui": "node scripts/test-sandbox.mjs ui",
		"test:e2e:debug": "node scripts/test-sandbox.mjs ui",
		"test:e2e:report": "playwright show-report",
		"db:start": "npx supabase start",
		"db:stop": "npx supabase stop",
		"db:reset": "npx supabase db reset",
		"db:types:check": "node scripts/check-db-types.mjs",
		"docstrings:check": "node scripts/docstring-coverage.mjs"
	},
	"devDependencies": {
		"@circleci/vitest-circleci-coverage": "^0.3.1081",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.6.6",
		"@types/sanitize-html": "^2.16.2",
		"@vitest/coverage-v8": "^4.1.12",
		"fake-indexeddb": "^6.2.8",
		"playwright": "^1.65.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.6",
		"vitest": "^4.1.12"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.6.0",
		"@sentry/sveltekit": "^11.11.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.0",
		"abcjs": "^6.7.2",
		"driver.js": "^1.10.2",
		"marked": "^18.1.3",
		"pdfjs-dist": "^6.5.438",
		"pitchy": "^4.1.0",
		"sanitize-html": "^2.18.1",
		"smplr": "^1.2.0",
		"tone": "^15.1.22"
	}
}
